index 0000000..3135703
--- /dev/null
+++ b/Sources/Services/RuntimeLinux/Server/PacketRelayInterface.swift
@@ -0,0 +1,14 @@
+import Containerization
+import ContainerizationExtras
+import Virtualization
+
+struct PacketRelayInterface: Interface, VZInterface {
+    let ipv4Address = try! CIDRv4("192.168.127.2/24")
+    let ipv4Gateway: IPv4Address? = try! IPv4Address("192.168.127.1")
+    let macAddress: MACAddress? = try! MACAddress("02:00:00:00:00:02")
+    private let socket: PacketSocket
+
+    init(path: String) throws { socket = try PacketSocket(path: path) }
+
+    func device() throws -> VZVirtioNetworkDeviceConfiguration { try socket.device() }
+}
