+    let headroom = (capacity / 8).min(64 << 20);
+    let bytes = bytes.max(16 << 10);
+    if available.saturating_sub(headroom).saturating_sub(*pending) < bytes {
+        return Err(io::Error::from(io::ErrorKind::StorageFull));
+    }
+    *pending += bytes;
+    Ok(WriteReservation {
+        writing: Arc::clone(writing),
+        bytes,
+    })
