+#[tokio::test]
+async fn concurrent_writers_cannot_double_spend_the_free_bytes() {
+    let (_dir, adapter) = adapter().await;
+    let stats = adapter.usage().unwrap();
+    let headroom = (stats.capacity_bytes / 8).min(64 << 20);
+    let available = stats.capacity_bytes - stats.used_bytes - headroom;
+    let size = available - available / 3;
+    let first = reserve(&adapter.root, &adapter.writing, size).unwrap();
+    assert!(reserve(&adapter.root, &adapter.writing, size).is_err());
+    drop(first);
+    assert!(reserve(&adapter.root, &adapter.writing, size).is_ok());
+}
