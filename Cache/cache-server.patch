+// Each location has at most one handoff lease. Repeated lookups extend it until a
+// transfer can acquire its own renewable lease, even if the helper restarts.
+pub(crate) async fn reserve_local_url(
+    db: &impl ConnectionTrait,
+    location: &str,
+    scope: ReaderLeaseScope,
+) -> Result<()> {
+    use sea_orm::sea_query::OnConflict;
+    storage_reader_leases::Entity::insert(storage_reader_leases::ActiveModel {
+        id: Set(location.to_owned()),
+        storage_location_id: Set(location.to_owned()),
+        scope: Set(scope),
+        expires_at: Set(deadline(LEASE_DURATION)),
+    })
+    .on_conflict(
+        OnConflict::column(storage_reader_leases::Column::Id)
+            .update_columns([
+                storage_reader_leases::Column::Scope,
+                storage_reader_leases::Column::ExpiresAt,
+            ])
+            .to_owned(),
+    )
+    .exec_without_returning(db)
+    .await?;
+    Ok(())
+}
