+            .unwrap()
+            .deleted_uploads,
+        1
+    );
+    let CreatedUpload::Created { upload: new, .. } = storage.create_upload(&second).await.unwrap()
+    else {
+        panic!("new upload after expiry")
+    };
+    assert!(
+        !storage
+            .upload_part(&old, 0, byte_stream("old"), Some(3))
+            .await
+            .unwrap()
