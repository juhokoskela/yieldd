+    use axum::body::Bytes;
+    use futures_util::{StreamExt as _, stream};
+    use sea_orm::{ActiveValue::Set, QueryFilter as _};
+    let server = TestServer::start().await;
+    let storage = std::sync::Arc::clone(&server.state.storage);
+    let mut ids = Vec::new();
+    let mut transfers = Vec::new();
+    for key in ["slow", "abandoned"] {
+        let CreatedUpload::Created { upload, .. } =
+            storage.create_upload(&identity(key)).await.unwrap()
+        else {
+            panic!("fixture upload")
+        };
+        ids.push(upload.id);
+        transfers.push(upload);
+    }
+    uploads::Entity::update_many()
+        .set(uploads::ActiveModel {
+            created_at: Set(now_ms() - 120_000),
+            ..Default::default()
+        })
+        .filter(uploads::COLUMN.id.is_in(ids.clone()))
+        .exec(&server.db().pool)
+        .await
+        .unwrap();
+    let active = transfers.remove(0);
+    let (entered, reading) = tokio::sync::oneshot::channel();
+    let (release, gate) = tokio::sync::oneshot::channel();
+    let writer = tokio::spawn(async move {
+        let stream = stream::once(async move {
+            entered.send(()).unwrap();
+            gate.await.unwrap();
+            Ok(Bytes::from_static(b"part"))
+        })
+        .boxed();
+        storage
+            .upload_part(&active, 0, stream, Some(4))
+            .await
+            .unwrap()
+    });
+    reading.await.unwrap();
+    let summary = server
+        .state
+        .cleanup
+        .run(Task::Uploads)
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(summary.deleted_uploads, 1);
+    assert!(
+        uploads::Entity::find_by_id(ids[0])
+            .one(&server.db().pool)
+            .await
+            .unwrap()
+            .is_some()
+    );
+    assert!(
+        uploads::Entity::find_by_id(ids[1])
+            .one(&server.db().pool)
+            .await
+            .unwrap()
+            .is_none()
+    );
+    let storage = std::sync::Arc::clone(&server.state.storage);
+    let finalize = tokio::spawn(async move {
+        storage
+            .complete_upload(&identity("slow"), None)
+            .await
+            .unwrap()
+    });
+    tokio::task::yield_now().await;
+    assert!(!finalize.is_finished());
+    release.send(()).unwrap();
+    assert!(writer.await.unwrap());
+    assert!(finalize.await.unwrap().is_some());
+    assert!(
+        server
+            .storage()
+            .complete_upload(&identity("slow"), None)
+            .await
+            .unwrap()
+            .is_none()
+    );
+}
