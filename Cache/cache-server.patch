+            .await
+            .unwrap()
+            .is_none()
+    );
+    uploads::Entity::update_many()
+        .set(uploads::ActiveModel {
+            created_at: Set(now_ms() - 120_000),
+            ..Default::default()
+        })
+        .filter(uploads::COLUMN.id.eq(old.id))
+        .exec(&server.db().pool)
