+    let server = TestServer::with(&[("MAX_CONCURRENT_MERGES", "0")]).await;
+    let parts = parts();
+    let location = save_parts(server.storage(), "multipart", &parts).await;
+    let expected = parts.concat();
+    let head = reqwest::Client::new()
+        .head(format!("{}/download/{}", server.url, location.id))
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(head.status(), 200);
+    assert_eq!(
+        response_header(&head, "content-length"),
+        Some(expected.len().to_string())
+    );
+    assert!(head.bytes().await.unwrap().is_empty());
+    assert_serves_ranges(&server, &location.id, &expected, "x-ms-range").await;
+    let full = get(&server, &location.id, None).await;
+    assert_eq!(
+        response_header(&full, "content-length"),
+        Some(expected.len().to_string())
+    );
+    assert_eq!(full.bytes().await.unwrap(), expected);
+    server.storage().wait_for_ongoing_merges().await;
+    assert!(
+        !server
+            .adapter()
+            .object_exists(&format!("{}/merged", location.folder_name))
+            .await
+            .unwrap()
+    );
