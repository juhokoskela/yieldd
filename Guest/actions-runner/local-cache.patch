                 List<IStep> jobSteps = null;
                 try
                 {
+                    if (Environment.GetEnvironmentVariable("YIELDD_LOCAL_CACHE") == "1")
+                    {
+                        // Bind the GitHub-issued token before any workflow code runs. The relay
