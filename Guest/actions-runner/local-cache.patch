+                            systemConnection.Authorization.Parameters[EndpointAuthorizationParameters.AccessToken]);
+                        using var response = await client.SendAsync(bind, HttpCompletionOption.ResponseHeadersRead, jobRequestCancellationToken);
+                        if (response.StatusCode != System.Net.HttpStatusCode.NoContent)
+                        {
+                            throw new InvalidOperationException($"The local cache rejected the job (HTTP {(int)response.StatusCode}).");
+                        }
+
+                        // Both JavaScript and container actions obtain ACTIONS_RESULTS_URL here.
+                        // The relay forwards artifact requests to this exact GitHub origin.
+                        if (systemConnection.Data.TryGetValue("ResultsServiceUrl", out var resultsUrl) &&
+                            string.Equals(resultsUrl?.TrimEnd('/'), "https://results-receiver.actions.githubusercontent.com", StringComparison.OrdinalIgnoreCase))
+                        {
+                            systemConnection.Data["ResultsServiceUrl"] = "http://192.168.127.1:7341/";
+                        }
+                    }
