#!/bin/bash
set -euo pipefail

if [[ "$#" -ne 1 ]] || [[ "$1" != ready ]]; then
    echo "usage: yieldd-runner-control ready" >&2
    exit 2
fi

console_user="$(stat -f %Su /dev/console)"
if [[ "$console_user" != runner ]]; then
    echo "the runner account is not logged in at the macOS console; found $console_user" >&2
    exit 1
fi

if ! launchctl print "gui/$(id -u)" >/dev/null; then
    echo "the runner GUI launchd domain is unavailable; enable automatic login for runner" >&2
    exit 1
fi
